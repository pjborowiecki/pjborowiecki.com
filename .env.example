# Copy to .env.local and fill in real values (never commit .env.local):
#   cp .env.example .env.local
#
# Preview / production: set the same variable names in Vercel → Project → Settings → Environment Variables.
# DB schema: `postinstall` migrates on Vercel (prod/preview env) or locally via `bun run db:migrate` when `.env.local` exists. `bun run build` is Next only. Prototype-only: `db:push`.
# With the Neon integration, DATABASE_URL is often injected for you; still set AUTH_SECRET and NEXT_PUBLIC_APP_URL per environment.
#
# Refresh local env from Vercel (optional):
#   vercel env pull .env.local

# App URL — use http://localhost:3000 locally; production / preview URLs in Vercel.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cloudflare Email — full send endpoint + bearer token (see API docs for body shape).
CLOUDFLARE_EMAIL_SERVICE_URL="cloudflare-email-service-url"
CLOUDFLARE_API_TOKEN="cloudflare-api-token"
